// Crystal Clear CRM — database schema
// SQLite + Prisma. Two models: Client and Job.
// A "Job" represents both quotes and booked work; the `status` field
// distinguishes them (QUOTE | SCHEDULED | COMPLETED | CANCELLED).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String?
  address   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
  knocks    Knock[]
}

model Job {
  id          Int      @id @default(autoincrement())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    Int
  title       String?
  // Legacy single service (kept for back-compat reads). New writes also set
  // serviceTypes below. App-level values: WINDOW | SOLAR | GUTTER | PRESSURE_WASHING.
  serviceType String?
  // JSON array of service codes for multi-service jobs, e.g. ["WINDOW","GUTTER"].
  serviceTypes String?
  // App-level values: QUOTE | SCHEDULED | COMPLETED | CANCELLED
  status      String   @default("QUOTE")
  scheduledAt DateTime
  // Stamped when status becomes COMPLETED; cleared if it moves back out. Drives rebooking.
  completedAt DateTime?
  price       Float    @default(0)
  notes       String?
  // Attribution: who sold the job (earns commission) and who worked it (paid hourly).
  soldBy      User?       @relation("JobsSold", fields: [soldById], references: [id], onDelete: SetNull)
  soldById    Int?
  workers     JobWorker[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([scheduledAt])
  @@index([serviceType])
  @@index([soldById])
}

// One person's labor on one job: hours worked at a per-job rate.
model JobWorker {
  id         Int   @id @default(autoincrement())
  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      Int
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  hours      Float @default(0)
  hourlyRate Float @default(0)

  @@unique([jobId, userId])
  @@index([userId])
}

// A single door-to-door knock logged on the canvassing map.
model Knock {
  id        Int      @id @default(autoincrement())
  lat       Float
  lng       Float
  address   String?
  // App-level values: NOT_HOME | CALLBACK | NOT_INTERESTED | INTERESTED | APPOINTMENT | SOLD | DO_NOT_KNOCK
  status    String   @default("NOT_HOME")
  notes     String?
  knockedAt DateTime @default(now())
  // Optional link to a client (e.g. once a door converts). Kept if the client is deleted.
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knockedAt])
  @@index([clientId])
}

// A person who can log into the CRM.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  // App-level values: OWNER | EMPLOYEE
  role         String   @default("EMPLOYEE")
  // Default pay rate ($/hr) for jobs this person works; can be overridden per job.
  defaultHourlyRate Float?
  jobsSold     Job[]       @relation("JobsSold")
  jobWork      JobWorker[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
